# Copy to .env (gitignored). Used by langgraph.json and settings.py.
OLLAMA_MODEL=llama3.2
# OLLAMA_TEMPERATURE=0

# Optional: LangSmith cloud traces (https://smith.langchain.com)
# Create an API key, then uncomment:
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langchain-first-chain
#
# Without a key, CLI / Studio still work locally — you just will not get
# LangSmith run traces. thread_id (session) is local persistence; each turn
# is a separate LangSmith *run* when tracing is on.
